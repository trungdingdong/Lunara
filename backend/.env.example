TAROT_APP_NAME="Tarot Reader API"
TAROT_ENVIRONMENT=dev
TAROT_REVERSAL_RATE=0.35

TAROT_LLM_PROVIDER=mock
TAROT_INTENT_CONFIDENCE_THRESHOLD=0.6

# SQLite by default; Postgres in docker-compose
# TAROT_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# TAROT_DATABASE_URL=postgresql+asyncpg://lunara:lunara@localhost:5432/lunara

# Auth - MUST change in any real deployment
TAROT_JWT_SECRET=dev-insecure-secret-change-me
TAROT_ACCESS_TOKEN_MINUTES=30
TAROT_REFRESH_TOKEN_DAYS=14

# To use Anthropic:
# TAROT_LLM_PROVIDER=anthropic
# TAROT_ANTHROPIC_API_KEY=sk-ant-your-key-here
# TAROT_ANTHROPIC_MODEL=claude-sonnet-4-5

# To use local Ollama:
# TAROT_LLM_PROVIDER=ollama
# TAROT_OLLAMA_BASE_URL=http://localhost:11434
# TAROT_OLLAMA_MODEL=llama3.2
